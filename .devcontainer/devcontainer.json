{
  "name": "KidvisionAccel",
  "image": "ghcr.io/tarensanders/r-base:latest",
  // Runs on the WSL host before the container starts. Creates the work folder,
  // a placeholder used when KIDVISION_ONEDRIVE is unset (kv_check() then
  // reports that no participant folders were found), and an empty .env.
  "initializeCommand": "mkdir -p \"$HOME/kidvision_work\" /tmp/kidvision_onedrive_not_set && touch \"${localWorkspaceFolder}/.env\"",
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.env"],
  "containerEnv": {
    "TZ": "Australia/Sydney",
    "KIDVISION_SOURCE_DIR": "/onedrive",
    "KIDVISION_WORK_DIR": "/work"
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/rstudio/.claude,type=volume",
    "source=gh-config-${devcontainerId},target=/home/rstudio/.gh,type=volume",
    "source=${localEnv:HOME}/Projects/square_eyes_tmp,target=/data,type=bind",
    // The synced 'Square Eyes - Community Sample' folder, read-only. Set
    // KIDVISION_ONEDRIVE in WSL (see README) before opening the container.
    "source=${localEnv:KIDVISION_ONEDRIVE:/tmp/kidvision_onedrive_not_set},target=/onedrive,type=bind,readonly",
    "source=${localEnv:HOME}/kidvision_work,target=/work,type=bind"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  // Installs the dependencies in DESCRIPTION, including the pinned GGIR and
  // GGIRread from its Remotes field.
  "postCreateCommand": "sudo chown -R $(id -un):$(id -gn) $HOME/.claude $HOME/.gh && Rscript -e 'pak::local_install_dev_deps(upgrade = FALSE)'"
}
